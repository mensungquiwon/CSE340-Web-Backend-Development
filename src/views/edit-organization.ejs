<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <div class="form-card">
        <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST">
            <div class="form-group">
                <label for="name">Organization Name</label>
                <input type="text" id="name" name="name" value="<%= organizationDetails.name %>" required maxlength="150" />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="500" required><%= organizationDetails.description %></textarea>
            </div>

            <div class="form-group">
                <label for="contactEmail">Contact Email</label>
                <input type="email" id="contactEmail" name="contactEmail" value="<%= organizationDetails.contact_email %>" maxlength="255" required />
            </div>

            <div class="form-group">
                <label for="logoFilename">Logo Filename</label>
                <input type="text" id="logoFilename" name="logoFilename" value="<%= organizationDetails.logo_filename %>" maxlength="255" required />
                <p class="form-hint">Enter the filename of the organization logo (e.g. redcross.png)</p>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Update Organization</button>
                <a href="/organizations/<%= organizationDetails.organization_id %>" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</main>
<%- include('partials/footer') %>
