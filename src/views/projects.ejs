<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>Here are some of our upcoming service projects:</p>
    <div class="project-grid">
        <% projects.forEach(project => { %>
            <div class="project-card">
                <li><a href="/projects/<%= project.project_id %>"><%= project.title %></a> - <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a></li>
            </div>
        <% }); %>
    </div>
</main>
<%- include('partials/footer') %>
