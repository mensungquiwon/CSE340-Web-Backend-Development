<%- include('partials/header') %>
<main>
    <h1>
        <%= title %>
        <% if (user && user.role_name === 'admin') { %>
            <a href="/new-organization" class="btn btn-primary btn-sm">+ Add Organization</a>
        <% } %>
    </h1>

    <p>Here are a few of our partner organizations:</p>

    <div class="org-grid">
        <% organizations.forEach(organization => { %>
            <div class="org-card">
                <div class="org-logo">
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                </div>
                <div class="org-info">
                    <h2><%= organization.name %></h2>
                    <p class="org-description"><%= organization.description %></p>
                    <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                        <a href="mailto:<%= organization.contact_email %>" class="org-email">
                            ✉ <%= organization.contact_email %>
                        </a>
                        <a href="/organizations/<%= organization.organization_id %>" class="btn btn-secondary btn-sm">View Details</a>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</main>
<%- include('partials/footer') %>
