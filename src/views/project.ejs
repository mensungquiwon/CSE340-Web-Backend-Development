<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
     <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
    <h2><%= project.title %></h2>
    <p><%= project.description %></p>
    <p>Date: <%= project.date.toDateString() %></p>
    <p>Location: <%= project.location %></p>
    <h3>Organization</h3>
    <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>
    
    <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a> 
<h3>Category(s)</h3>

<% if (categories && categories.length > 0) { %>
  <% categories.forEach(category => { %>
    <a href="/categories/<%= category.category_id %>">
      <%= category.name %>
    </a>

  <% }) %>
<% } else { %>
  <p>No categories assigned.</p>
<% } %>

</main>
<%- include('partials/footer') %>