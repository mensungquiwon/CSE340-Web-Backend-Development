<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <h2><%= category.name %></h2>

  <h3>Projects in this Category</h3>

  <% if (projects && projects.length > 0) { %>
    <ul>
      <% projects.forEach(project => { %>
        <li>
          <a href="/projects/<%= project.project_id %>">
            <%= project.title %>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No projects found in this category.</p>
  <% } %>
</main>