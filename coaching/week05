const requireRole = (role) => {
    return (req, res, next) => {
        // Check if user is logged in first
        if (!req.session || !req.session.user) {
            req.flash('error', 'You must be logged in to access this page.');
            return res.redirect('/login');
        }

        // Check if user's role matches the required role
        if (req.session.user.role_name !== role) {
            req.flash('error', 'You do not have permission to access this page.');
            return res.redirect('/');
        }

        // User has required role, continue
        next();
    };
};

------------------------------------------------------------

COACH: This is excellent code, Jonathan! requireRole is a really elegant pattern — it's a function that returns another function, which is exactly how Express middleware works.

I want to focus on the very last line inside the middleware — next(). Can you explain in your own words what you think next() does and what would happen if you forgot to call it?

